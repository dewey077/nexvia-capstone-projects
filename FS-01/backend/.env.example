PORT=5000
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://localhost:27017/marketplace
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES=7d
# Optional: leave blank to use in-memory cart cache
REDIS_URL=redis://localhost:6379
# Optional: if unreachable, MongoDB search fallback is used automatically
ES_NODE=http://localhost:9200
# Optional: leave blank to save images in /uploads
AWS_REGION=ap-south-1
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: leave blank for built-in mock payment mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
COMMISSION_PERCENT=10
